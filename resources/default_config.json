{
  "_comment": "全新安裝的預設設定。使用者的實際設定存在 %APPDATA%/VoiceTyper/config.json；這份只當第一次啟動的範本與缺漏欄位的後援。profiles 由 default_profiles.json 注入。",
  "hotkey": "ctrl+alt+z",
  "hotkey_suppress": true,
  "cancel_hotkey": "ctrl+alt+x",
  "streaming_hotkey": "ctrl+shift+l",
  "language": "zh",
  "input_device": "",
  "whisper_prompt": "嗯，這是繁體中文的對話內容，會包含完整的標點符號。",
  "transcriber": {"provider": "openai", "model": "whisper-1"},
  "enhancer": {"provider": "anthropic", "model": "claude-haiku-4-5-20251001"},
  "active_profile_id": "default",
  "auto_paste": true,
  "play_sound": true,
  "restore_clipboard": true,
  "show_waveform": true,
  "save_history": true,
  "use_speaker_diarization": false,
  "theme": "system",
  "vad_silence_threshold": 0.022,
  "vad_silence_flush_seconds": 0.7,
  "vad_min_chunk_seconds": 1.0,
  "vad_max_chunk_seconds": 8.0,
  "silence_rms_threshold": 0.005
}
