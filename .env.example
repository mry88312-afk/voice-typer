# Voice Typer 環境變數範本
# 把這個檔案複製成 .env，然後填入你自己的 API Key
#
# 4 個 provider，至少要設 1 個轉錄 (OpenAI 或 Groq) 才能用

# ─── OpenAI ─────────────────────────────────────
# Whisper 語音轉文字 + GPT-4o 系列潤色
# 取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Anthropic Claude ──────────────────────────
# AI 潤色 (Haiku 4.5 / Sonnet 4.6 / Opus 4.7)
# 取得: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ─── Groq (超快免費) ───────────────────────────
# Whisper Large v3 Turbo 轉錄 (極快、免費) + Llama 潤色
# 取得: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# ─── Google Gemini ─────────────────────────────
# 會議錄音聲紋分離 / 多模態音訊分析
# 取得: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-key-here
